# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Production URL (used for auth redirects, OG tags, and internal API calls)
NEXT_PUBLIC_SITE_URL=https://buildbridge.ng

# ── Paystack ────────────────────────────────────────────────────────────────
# Use test keys (pk_test_ / sk_test_) for development.
# Switch to LIVE keys (pk_live_ / sk_live_) in production — also update the
# webhook signing secret in your Paystack dashboard to the live secret.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# ── Twilio (OTP / SMS) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA...

# ── Upstash Redis (rate limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Identity Verification ───────────────────────────────────────────────────
# REQUIRED: random secret used to salt NIN/BVN hashes before storage.
# Generate with: openssl rand -hex 32
# Do NOT use the same value across environments.
IDENTITY_SALT=your_random_64_char_hex_secret

# ── DeepSeek (AI story/impact generation) ───────────────────────────────────
DEEPSEEK_API_KEY=sk-...
